--- !u!114 &1105346857
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1105346853}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b9bcbdb6cad226d4e87098d25112fadc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: DamRush::DamRush.BuildOrders
  damMk2:
    kind: 1
    name: Dam Mk2
    rule: 'Stronger dam (wears 60% slower). When finished it works as a base: a nursery
      or storage can stand on it. If the dam loses a stage, the building on it is
      lost (half comes back).'
    wearFactor: 0.4
    platform: 1
    stages:
    - name: base (stones + mud)
      wood: 0
      mud: 2
      stone: 3
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
      height: 0.7
      leakiness: 0.5
    - name: body (sticks)
      wood: 5
      mud: 0
      stone: 0
      pressedWood: 3
      gravel: 0
      sand: 0
      cement: 0
      height: 1.6
      leakiness: 0.9
    - name: seal (mud)
      wood: 0
      mud: 3
      stone: 0
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
      height: 1.8
      leakiness: 0.05
    - name: stone cap
      wood: 0
      mud: 2
      stone: 3
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 2
      height: 2
      leakiness: 0.03
  spillway:
    kind: 2
    name: Spillway
    rule: Low stone dam (1.0 m). Water runs over the top without wear, so the pond
      behind it stays at this level. Put it in a dam line where the extra water should
      go.
    wearFactor: 0
    platform: 0
    stages:
    - name: base (stones + mud)
      wood: 0
      mud: 2
      stone: 3
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
      height: 0.5
      leakiness: 0.4
    - name: stone crest
      wood: 0
      mud: 1
      stone: 3
      pressedWood: 0
      gravel: 4
      sand: 0
      cement: 0
      height: 1
      leakiness: 0.05
  pumpBaseDef:
    kind: 3
    name: Pump base
    rule: Base that pumps water from the lowest wet hex nearby (downstream) into
      the hexes around it, up to 0.5 m higher. A nursery on it needs 0.5 m less water.
    stages:
    - name: stones
      wood: 0
      mud: 1
      stone: 4
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
    - name: pipe
      wood: 4
      mud: 2
      stone: 0
      pressedWood: 2
      gravel: 0
      sand: 0
      cement: 0
    - name: mud top
      wood: 0
      mud: 3
      stone: 0
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 1
  pumpLift: 0.5
  pumpRate: 0.6
  pumpReachMin: 2
  pumpReachMax: 5
  farmDef:
    kind: 4
    name: Food farm
    rule: Water lilies and duckweed on a calm hex with water 0.15-1.0 m deep. Grows
      food for the foragers; nothing grows in winter.
    stages:
    - name: mud beds
      wood: 0
      mud: 4
      stone: 0
      pressedWood: 0
      gravel: 0
      sand: 2
      cement: 0
    - name: planting
      wood: 1
      mud: 2
      stone: 0
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
  farmFoodPerDay: 8
  farmMax: 12
  farmMinDepth: 0.15
  farmMaxDepth: 1
  farmMaxSpeed: 0.6
  digStep: 0.35
  digMax: 1.5
  digLoadsPerStep: 3
  machineType: splitter
  levee:
    kind: 3
    name: Levee
    rule: Cheap earth bank (0.8 m). Put a line of levees around buildings to keep
      flood water out. Can stand on dry ground.
    wearFactor: 1
    platform: 0
    stages:
    - name: earth bank
      wood: 0
      mud: 3
      stone: 0
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
      height: 0.8
      leakiness: 0.15
  floodgate:
    kind: 4
    name: Floodgate
    rule: 'Dam with a gate (1.6 m). Open it (click it) before a flood: the water
      runs through and the gate does not wear. Close it to hold the water again.'
    wearFactor: 1
    platform: 0
    stages:
    - name: stone sill
      wood: 0
      mud: 2
      stone: 3
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
      height: 0.6
      leakiness: 0.5
    - name: gate
      wood: 4
      mud: 1
      stone: 0
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
      height: 1.6
      leakiness: 0.05
  bellDef:
    kind: 9
    name: Alarm bell
    rule: 'Click it to ring the alarm: the family swims to the lodge. Click again
      for the all clear. Floods give no alarm by themselves.'
    stages:
    - name: post
      wood: 3
      mud: 0
      stone: 0
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
    - name: bell
      wood: 0
      mud: 1
      stone: 1
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
  sandbagCost:
    name: sandbags
    wood: 0
    mud: 0
    stone: 0
    pressedWood: 0
    gravel: 0
    sand: 2
    cement: 0
  sandbagHeight: 0.3
  sandbagWearCut: 0.3
  sandbagDaysAfterFlood: 2
  pressureWear: 0.04
  pressureSafe: 0.4
  colony: {fileID: 1105346858}
  grid: {fileID: 1447305950}
  water: {fileID: 505461982}
  cam: {fileID: 777772766}
  buildTime: 2
  removeConfirmTime: 3
  wearRate: 0.06
  repairInstinctNoise: 0.25
  repairShare: 0.5
  dropShare: 0.5
  stoneMat: {fileID: 2100000, guid: c2757dd99d2c9344f9df54f6e7637b1c, type: 2}
  woodMat: {fileID: 2100000, guid: a9153491356dc1f499a5fdb0fc98ffc5, type: 2}
  mudMat: {fileID: 2100000, guid: e3a41ffadd4ec0d4e98b18efbfe267e6, type: 2}
  damStages:
  - name: base (stones + mud)
    wood: 0
    mud: 2
    stone: 2
    pressedWood: 0
    gravel: 0
    sand: 0
    cement: 0
    height: 0.6
    leakiness: 0.6
  - name: body (sticks)
    wood: 4
    mud: 0
    stone: 0
    pressedWood: 0
    gravel: 0
    sand: 0
    cement: 0
    height: 1.4
    leakiness: 1
  - name: seal (mud)
    wood: 0
    mud: 3
    stone: 0
    pressedWood: 0
    gravel: 0
    sand: 0
    cement: 0
    height: 1.6
    leakiness: 0.05
  baseHeight: 1.2
  baseDryMargin: 0.2
  nurseryMinDepth: 0.7
  storageCapacity: 40
  storageType: 1
  buildingDefs:
  - kind: 0
    name: Base
    rule: Platform for buildings. Water here max 1.0 m deep.
    stages:
    - name: stones
      wood: 0
      mud: 1
      stone: 3
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
    - name: mud top
      wood: 0
      mud: 3
      stone: 0
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
  - kind: 1
    name: Nursery
    rule: On a base. Needs water 0.7 m deep next to it (entrance under water). Makes
      kits from wood.
    stages:
    - name: frame
      wood: 6
      mud: 0
      stone: 0
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
    - name: mud walls
      wood: 0
      mud: 4
      stone: 0
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
  - kind: 2
    name: Storage
    rule: 'On a base. Holds 40 of one material or food: pick the type before you
      place it.'
    stages:
    - name: frame
      wood: 4
      mud: 0
      stone: 0
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
    - name: floor
      wood: 0
      mud: 2
      stone: 0
      pressedWood: 0
      gravel: 0
      sand: 0
      cement: 0
