  m_text: '<color=#FFCC33>V</color>  build tool        <color=#FFCC33>C</color> 
    erase tool

    <color=#FFCC33>DRAG</color>  draw a line / erase an area       
    <color=#FFCC33>R</color>  rotate

    <color=#FFCC33>MIDDLE CLICK</color>  move
    a brick        <color=#FFCC33>CTRL+Z</color>  undo

    <color=#FFCC33>1-4</color> 
    material        <color=#FFCC33>Z / X</color>  size        <color=#FFCC33>TAB</color> 
    person

    <color=#FFCC33>B</color>  shop        <color=#FFCC33>HOLD RIGHT +
    WASD</color>  fly        <color=#FFCC33>Q / E</color>  down / up

    <color=#FFCC33>ENTER</color> 
    start        <color=#FFCC33>F5</color>  new island (round 1 only)'
